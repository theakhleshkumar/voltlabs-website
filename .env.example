# Copy to .env.local and fill in. .env* is gitignored -- never commit real values.
# The same four variables go into Vercel: Settings -> Environment Variables.

# ---- Database -------------------------------------------------------------
# Neon Postgres. Use the POOLED connection string (host contains "-pooler"),
# not the direct one, or serverless functions will exhaust the connection limit.
# Keep ?sslmode=require on the end.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/voltlabs?sslmode=require"

# ---- Razorpay -------------------------------------------------------------
# Dashboard -> Settings -> API Keys. Start with TEST mode keys (rzp_test_...)
# and only switch to live (rzp_live_...) after a full test transaction.
#
# KEY_ID is safe in the browser. KEY_SECRET must never reach the client:
# it is read only inside API routes, and has no NEXT_PUBLIC_ prefix so Next.js
# will not bundle it.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""

# Dashboard -> Settings -> Webhooks. You choose this string when creating the
# webhook; it signs the payload so forged "payment succeeded" calls are rejected.
RAZORPAY_WEBHOOK_SECRET=""

# ---- Site -----------------------------------------------------------------
# Used to build absolute URLs in confirmation emails and redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
