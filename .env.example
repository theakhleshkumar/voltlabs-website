# Copy to .env.local and fill in. .env* is gitignored -- never commit real values.
# The same variables go into Vercel (Settings -> Environment Variables), and
# later into AWS Secrets Manager or Amplify environment variables.
#
# GET /api/health reports which of these are configured on a running
# deployment, without ever revealing the values.

# ---- Database (required) --------------------------------------------------
# Neon Postgres. Use the POOLED connection string (host contains "-pooler"),
# not the direct one, or serverless functions will exhaust the connection limit.
# Keep ?sslmode=require on the end.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/voltlabs?sslmode=require"

# ---- Site (required in production) ----------------------------------------
# Absolute URL, used for links in customer emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Admin panel (required for /admin) ------------------------------------
# A single shared password guards /admin. Generate long random values:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_SESSION_SECRET signs the session cookie; changing it signs everyone out.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# ---- Email over SMTP (optional, strongly recommended) ---------------------
# Any SMTP server. Today this is your own domain mailbox; on AWS it becomes SES,
# which also speaks SMTP -- so that move is a change of these four values and no
# code at all.
#
# Without these, orders and contact messages are still SAVED, but written to the
# log instead of emailed.
#
# Hostinger:  smtp.hostinger.com   port 465
# Gmail/Workspace: smtp.gmail.com  port 587 (needs an App Password, not your
#                                            normal password)
# AWS SES:    email-smtp.<region>.amazonaws.com  port 587
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER="admin@voltlabs.in"
SMTP_PASSWORD=""
# Optional. Port 465 implies TLS; set true only to force it on another port.
SMTP_SECURE=""

# The From address shown to recipients. Must be an address your SMTP server is
# allowed to send as, or mail will be rejected or land in spam.
MAIL_FROM="VoltLabs <admin@voltlabs.in>"

# Where order notifications and contact messages are delivered.
ORDER_NOTIFICATION_EMAIL="admin@voltlabs.in"

# ---- Razorpay (optional; online payment is hidden until these are set) -----
# Dashboard -> Settings -> API Keys. Start with TEST keys (rzp_test_...) and
# only switch to live after a full test transaction.
#
# KEY_ID is safe in the browser. KEY_SECRET must never reach the client: it is
# read only inside API routes and has no NEXT_PUBLIC_ prefix, so Next.js will
# not bundle it.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
#
# Dashboard -> Settings -> Webhooks. You choose this string when creating the
# webhook; it signs the payload so forged "payment succeeded" calls are rejected.
# Webhooks cannot reach localhost -- use a Vercel preview URL or a tunnel.
RAZORPAY_WEBHOOK_SECRET=""
